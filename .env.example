# Persistent likes, copies, shares and quote submissions
# Add the Neon connection string to Vercel Project Settings -> Environment Variables.
DATABASE_URL=

# Shared rate limits for public write APIs. Required for rate limits to span
# Vercel/serverless instances; without it, development uses an in-memory limit.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: canonical site URL
NEXT_PUBLIC_SITE_URL=https://mayalines.com

# Private editor access for /admin/submissions (keep this secret).
ADMIN_REVIEW_TOKEN=
